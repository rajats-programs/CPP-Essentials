```

---

## File Writing

```cpp
#include <fstream>

ofstream file("data.txt");

file<<"Hello";

file.close();
```

---

## File Reading

```cpp
#include <fstream>

ifstream file("data.txt");

string text;

file>>text;

file.close();
```

---

## File Append

```cpp
ofstream file("data.txt",ios::app);

file<<"Hello";

file.close();
```

