#include <bits/stdc++.h>
using namespace std;

int main(){
  int choice,computer;
  int your_score=0,computer_score=0;

  cout<<"Welcome to the Game of Rock, Paper and Scissor!"<<endl;
  cout<<"The following number represents Rock,Paper and Scissor respectively:"<<endl;
  cout<<"Rock=0"<<endl;
    cout<<"Paper=1"<<endl;
      cout<<"Scissor=2"<<endl<<endl;

  srand(time(0));
  
 cout << "First to score 3 points wins!\n";
  
  do
  { 
  computer = rand()%3;
    cout<<"Rock,Paper or Scissor"<<endl;
  cin>>choice;
  switch (choice)
  {
  case 0:
  cout<<"You chose Rock"<<endl;
    break;
    
    case 1:
    cout<<"You chose Paper"<<endl;
    break;

     case 2:
    cout<<"You chose Scissor"<<endl;
    break;

    default:
    cout<<"Invalid choice"<<endl;
    break;
  }

  switch (computer)
  {
  case 0:
  cout<<"Computer chose Rock"<<endl;
  break;
  
   case 1:
   cout<<"Computer chose Paper"<<endl;
    break;
    
    case 2:
    cout<<"Computer chose Scissor"<<endl;
    break;
    
    default:
    cout<<"Invalid choice"<<endl;
    break;
  }
  
  if (computer == choice)
  {
    cout<<"DRAW"<<endl;
  }
 
  else if (computer==0 && choice==1||choice==0 && computer==2||computer==1 && choice==2)
  {
    cout<<"YOU WIN"<<endl;
    your_score+=1;
  }
  else if (choice==1 && computer==2||computer==0 && choice==2||choice==0 && computer==1)
   {
     cout<<"COMPUTER WINS"<<endl;
     computer_score+=1;
    }
    
  } while (your_score!=3&&computer_score!=3);

  if (your_score>computer_score)
  {
    cout<<"Congratulations! You won the game!"<<endl;
  }
  else
  {
    cout<<"Better luck next time! Computer won the game!"<<endl;
  }

    return 0;
}

//I learnt one thing in this project that condition for do while loop is while (your_score!=3&&computer_score!=3);
// and not (your_score!=3||computer_score!=3) as there exist true false check like we do in logic gates
