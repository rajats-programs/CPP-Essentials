using namespace std;

float add(float,float);
float sub(float,float);
float mul(float,float);
float div(float,float);
int rem(int,int);

int main()
{
cout<< "Welcome to the Simple Calculator!"<<endl;
float a,b;
int option;
float result;
cout<<"Enter the first number: "<<endl;
cin>>a;
cout<<endl;
cout<<"Enter the second number: "<<endl;
cin>>b;
cout<<endl;
cout<<endl;

cout<<"1.Addition\t2.Subtraction\n3.Multiplication\t4.Divison\n5.Remainder"<<endl;
cout<<"Select the operation you want to perform"<<endl;
  cin>>option;

  switch (option)
  {
  case 1:
    cout<<"Addition of 2 numbers is ";
    result = add(a,b);
    cout<<result<<endl;
    break;
    case 2:
    cout<<"Subtraction of 2 numbers is ";
    result = sub(a,b);
    cout<<result<<endl;
    break;
    case 3:
     cout<<"Multiplication of 2 numbers is ";
     result = mul(a,b);
     cout<<result<<endl;
    break;
    case 4:
   
     result = div(a,b);
 if (result==0)
     {
      break;
     }
     else
     {
      cout<<"Division of 2 numbers is ";
      cout<<result<<endl;
     }
     
    break;
    case 5:
     
     result = rem(a,b);
     if (result==0)
     {
      break;
     }
     
    else
    {
      cout<<"Remainder of 2 numbers is ";
