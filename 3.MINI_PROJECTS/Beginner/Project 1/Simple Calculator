    }
    
    break;
  
  default:
    cout<<"Invalid choice"<<endl;
    break;
  }

return 0;
}


float add(float a,float b){
  return a + b;
}
float sub(float a,float b){
  return a - b;
}
float mul(float a,float b){
  return a * b;
}
float div(float a,float b){
  if (b==0)
  {
    cout<<"Error:invalid input"<<endl;
    return 0;
  }
  else
  {
    return a / b;
  }
}
int rem(int a,int b){
  if (b==0)
  {
    cout<<"Error:invalid input"<<endl;
    return 0;
  }
  else
  {
    return a % b;
  }
}


